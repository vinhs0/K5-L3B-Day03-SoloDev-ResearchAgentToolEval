{
  "dataset_id": "day03_v2_research_group",
  "dataset_role": "group",
  "description": "Case do NHÓM tự viết thêm để cover thêm trường hợp. Mỗi case cần: id, phase='B', query HOẶC turns, failure_type (thuộc allowed_failure_types), và expect (tool_calls[...] hoặc no_tool=true). Nên kèm metadata.what_it_tests.",
  "allowed_failure_types": ["wrong_tool", "wrong_arg_value", "wrong_boundary", "unnecessary_tool", "out_of_scope", "missing_info"],
  "cases": [
    {
      "id": "S01_route_wikipedia",
      "phase": "B", "suite": "group",
      "query": "Alan Turing là ai?",
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [{"name": "wikipedia", "args": {}}]},
      "metadata": {"skill": "routing_wikipedia", "difficulty": "medium", "what_it_tests": "Câu hỏi tiểu sử/định nghĩa nền tảng -> wikipedia (tool mới), không phải lookup."}
    },
    {
      "id": "S02_route_hackernews_args",
      "phase": "B", "suite": "group",
      "query": "Cho mình 3 bài mới nhất về Rust trên Hacker News",
      "failure_type": "wrong_arg_value",
      "expect": {"tool_calls": [{"name": "hackernews", "args": {"sort": "date", "limit": 3}}]},
      "metadata": {"skill": "routing_hackernews", "difficulty": "medium", "what_it_tests": "Nhắc rõ Hacker News -> hackernews (tool mới) với sort=date ('mới nhất') và limit=3."}
    },
    {
      "id": "S03_route_current_time_tz",
      "phase": "B", "suite": "group",
      "query": "Bây giờ ở Tokyo là mấy giờ?",
      "failure_type": "wrong_arg_value",
      "expect": {"tool_calls": [{"name": "current_time", "args": {"timezone": "Asia/Tokyo"}}]},
      "metadata": {"skill": "routing_current_time", "difficulty": "medium", "what_it_tests": "Hỏi giờ hiện tại -> current_time (tool mới) với timezone IANA Asia/Tokyo."}
    },
    {
      "id": "S04_confirm_before_send",
      "phase": "B", "suite": "group",
      "query": "Gửi bản tóm tắt hôm nay lên kênh Telegram của team",
      "failure_type": "wrong_boundary",
      "expect": {"tool_calls": [{"name": "clarify", "args": {"response_type": "yes_no"}}]},
      "metadata": {"skill": "confirm_before_write", "difficulty": "medium", "what_it_tests": "Yêu cầu gửi ra ngoài -> clarify yes_no xin xác nhận, KHÔNG gọi send trực tiếp."}
    },
    {
      "id": "S05_out_of_scope_recipe",
      "phase": "B", "suite": "group",
      "query": "Cho mình công thức nấu phở bò với.",
      "failure_type": "out_of_scope",
      "expect": {"no_tool": true, "behavior": "refuse"},
      "metadata": {"skill": "out_of_scope_cooking", "difficulty": "easy", "what_it_tests": "Câu nấu ăn ngoài phạm vi research/news -> KHÔNG gọi tool."}
    },
    {
      "id": "M01_switch_web_to_social_top",
      "phase": "B", "suite": "group",
      "turns": [
        {"role": "user", "content": "Tin tức về Anthropic tuần này"},
        {"role": "user", "content": "Giờ cho mình xem các tweet nổi bật nhất về Anthropic trên Twitter, 3 bài thôi"}
      ],
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [{"name": "social_search", "args": {"query": "Anthropic", "search_type": "Top", "limit": 3}}]},
      "metadata": {"skill": "multiturn_switch_tool", "difficulty": "hard", "what_it_tests": "Chuyển từ web sang Twitter: social_search, search_type=Top ('nổi bật'), limit=3."}
    },
    {
      "id": "M02_hackernews_correction",
      "phase": "B", "suite": "group",
      "turns": [
        {"role": "user", "content": "Tìm bài về Rust trên Hacker News"},
        {"role": "user", "content": "À nhầm, mình muốn về Go chứ không phải Rust"},
        {"role": "user", "content": "Lấy 3 bài mới nhất thôi"}
      ],
      "failure_type": "wrong_arg_value",
      "expect": {"tool_calls": [{"name": "hackernews", "args": {"query": "Go", "sort": "date", "limit": 3}}]},
      "metadata": {"skill": "multiturn_correction_new_tool", "difficulty": "hard", "what_it_tests": "3 turns với hackernews (tool mới): sửa chủ đề Rust -> Go, sort=date và limit=3 từ lượt cuối."}
    },
    {
      "id": "M03_current_time_change_tz",
      "phase": "B", "suite": "group",
      "turns": [
        {"role": "user", "content": "Bây giờ là mấy giờ?"},
        {"role": "user", "content": "À, ý mình là giờ ở New York"}
      ],
      "failure_type": "wrong_arg_value",
      "expect": {"tool_calls": [{"name": "current_time", "args": {"timezone": "America/New_York"}}]},
      "metadata": {"skill": "multiturn_timezone_new_tool", "difficulty": "medium", "what_it_tests": "Lượt sau đổi múi giờ: current_time (tool mới) với timezone America/New_York."}
    },
    {
      "id": "M04_wikipedia_switch_language",
      "phase": "B", "suite": "group",
      "turns": [
        {"role": "user", "content": "Alan Turing là ai?"},
        {"role": "user", "content": "Cho mình bản tiếng Việt"}
      ],
      "failure_type": "wrong_arg_value",
      "expect": {"tool_calls": [{"name": "wikipedia", "args": {"lang": "vi"}}]},
      "metadata": {"skill": "multiturn_lang_new_tool", "difficulty": "medium", "what_it_tests": "Lượt sau yêu cầu tiếng Việt: wikipedia (tool mới) với lang=vi."}
    },
    {
      "id": "M05_clarify_topic_then_news_month",
      "phase": "B", "suite": "group",
      "turns": [
        {"role": "user", "content": "Tìm tin tức giúp mình"},
        {"role": "user", "content": "Về robotics nhé"},
        {"role": "user", "content": "Chỉ trong tháng này thôi"}
      ],
      "failure_type": "missing_info",
      "expect": {"tool_calls": [{"name": "lookup", "args": {"query": "robotics", "topic": "news", "timeframe": "month"}}]},
      "metadata": {"skill": "multiturn_clarify_fill", "difficulty": "hard", "what_it_tests": "3 turns: thiếu chủ đề ban đầu, điền robotics ở lượt 2, timeframe=month ở lượt 3, topic=news."}
    }
  ]
}
